{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenFolio",
  "version": "../package.json",
  "identifier": "org.openfolio.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenFolio",
        "width": 640,
        "height": 400,
        "minWidth": 640,
        "minHeight": 400,
        "center": true,
        "decorations": false,
        "skipTaskbar": false,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Editor open source per copioni e romanzi",
    "longDescription": "OpenFolio e un editor open source per scrivere copioni (screenplay) e romanzi, con Binder, corkboard, outline, snapshot, revisioni ed export FDX/Fountain/DOCX/EPUB/PDF.",
    "copyright": "GPL-3.0-or-later",
    "fileAssociations": [
      {
        "ext": ["ofp", "openfolio"],
        "name": "OpenFolio Project",
        "description": "Progetto OpenFolio (OpenFolio Project)",
        "role": "Editor",
        "mimeType": "application/x-openfolio"
      }
    ],
    "resources": {
      "icons/document.ico": "document.ico"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/installer-hooks.nsh",
        "languages": ["English", "Italian"],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0NjRBMjgxMUVBQ0MyM0MKUldROHdxd2VnYUprUlBuU2szUmpqeXRlL2I1dVlNNjJYWnVSTTBzVlRaeVF4cXdyTzB3aU1rYlUK",
      "endpoints": [
        "https://github.com/francescoflora/openfolio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
