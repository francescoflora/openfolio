{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenFolio",
  "version": "0.1.0",
  "identifier": "org.openfolio.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenFolio",
        "width": 760,
        "height": 520,
        "minWidth": 640,
        "minHeight": 460,
        "center": true,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Editor open source per copioni e romanzi",
    "longDescription": "OpenFolio e un editor open source per scrivere copioni (screenplay) e romanzi, con Binder, corkboard, outline, snapshot, revisioni ed export FDX/Fountain/DOCX/EPUB/PDF.",
    "copyright": "GPL-3.0-or-later",
    "fileAssociations": [
      {
        "ext": ["openfolio"],
        "name": "OpenFolio Document",
        "description": "Documento di Scrittura OpenFolio",
        "role": "Editor",
        "mimeType": "application/x-openfolio"
      },
      {
        "ext": ["scriptforge"],
        "name": "ScriptForge Legacy Document",
        "description": "Documento ScriptForge (Retrocompatibile)",
        "role": "Editor",
        "mimeType": "application/x-scriptforge"
      }
    ],
    "resources": {
      "icons/document.ico": "document.ico"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/installer-hooks.nsh",
        "languages": ["Italian", "English"],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
